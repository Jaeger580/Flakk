.flakkDots {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    font-size: 64px;
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/Oxanium-VariableFont_wght.ttf?fileID=12800000&guid=18af7650e00930b48b048a87fcc0a4d3&type=3#Oxanium-VariableFont_wght");
    -unity-font-definition: initial;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    transform-origin: left bottom;
    transition-delay: 0.2s;
}

.flakkTitleHoverable:hover {
    scale: 1.02 1.02;
    text-shadow: 2px 0 2px rgba(128, 199, 255, 0.5);
}

.flakkTitleHoverable:focus .flakkTitleFull {
    transition-duration: 1s;
    transition-timing-function: ease-out;
    width: 250px;
    transition-property: all;
    transform-origin: left bottom;
    transition-delay: 0.25s;
}

.flakkTitleHoverable:focus .flakkDots {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    font-size: 64px;
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/Oxanium-VariableFont_wght.ttf?fileID=12800000&guid=18af7650e00930b48b048a87fcc0a4d3&type=3#Oxanium-VariableFont_wght");
    -unity-font-definition: initial;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
    opacity: 0;
    transform-origin: left bottom;
    rotate: 180deg;
    transition-delay: 0s;
}

.flakkTitleHoverable:focus .flakkTitleWords {
    transition-duration: 1s;
    transition-timing-function: ease-out;
    color: rgb(255, 226, 138);
}

