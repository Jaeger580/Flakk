<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Infrastructure/UIToolkit%20Stuff/TerminalStyleSheet.uss?fileID=7433441132597879392&amp;guid=96d5bf98c481b49caa12dd0ff60b4887&amp;type=3#TerminalStyleSheet" />
    <ui:VisualElement name="TerminalView" style="width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Infrastructure/UIToolkit%20Stuff/FLAKK_BG.png?fileID=2800000&amp;guid=fbbd172fe81f347bda948adb12e2378c&amp;type=3#FLAKK_BG&quot;); -unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Oxanium-VariableFont_wght.ttf?fileID=12800000&amp;guid=18af7650e00930b48b048a87fcc0a4d3&amp;type=3#Oxanium-VariableFont_wght&quot;);">
        <ui:VisualElement name="ScreenParent" class="screenParent" style="position: absolute;">
            <ui:VisualElement name="LeftAnchor" class="ltrAnchors" style="width: 20%;">
                <ui:VisualElement name="TopAnchor" class="ttbAnchors" />
                <ui:VisualElement name="MiddleAnchor" class="ttbAnchors" />
                <ui:VisualElement name="BottomAnchor" class="ttbAnchors" />
            </ui:VisualElement>
            <ui:VisualElement name="CenterAnchor" class="ltrAnchors" style="width: 60%;">
                <ui:VisualElement name="TopAnchor" class="ttbAnchors" />
                <ui:VisualElement name="MiddleAnchor" class="ttbAnchors mainMenuButtons" style="height: 100%; flex-wrap: wrap; flex-direction: column; align-items: flex-start; align-self: center;">
                    <ui:Label tabindex="-1" text="Contracts" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" class="contentTitle" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; position: absolute; width: 100%; font-size: 32px; -unity-text-align: middle-center; top: -5px;" />
                    <ui:VisualElement name="MissionContainer" class="contentContainer" style="flex-grow: 1; width: 100%; height: 90%; flex-direction: row; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-color: rgba(51, 51, 51, 0);">
                        <ui:VisualElement name="ContractArea" class="statDetailContainer" style="flex-grow: 1; width: 30%;">
                            <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MissionTitle" class="contentTitle" />
                            <ui:VisualElement name="ContractList">
                                <ui:Button text="Contract 1" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MissionButton" class="textButton statText" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="statDetailContainer" style="flex-grow: 1; width: 80%;">
                            <ui:Label tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" class="contentTitle" />
                            <ui:VisualElement style="flex-grow: 1;">
                                <ui:Label tabindex="-1" text="Lorem ipsum" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MissionDesc" class="statText" style="white-space: normal; font-size: 32px; -unity-text-align: middle-left;" />
                                <ui:Label tabindex="-1" text="Lorem ipsum" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MissionReward" class="statText" style="white-space: normal; -unity-font-style: bold-and-italic; border-left-color: rgb(128, 199, 255); border-right-color: rgb(128, 199, 255); border-top-color: rgb(128, 199, 255); border-bottom-color: rgb(128, 199, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; -unity-text-align: middle-right;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button text="Start Contract" parse-escape-sequences="true" display-tooltip-when-elided="true" name="StartMission" class="text-only-button" style="font-size: 20px; align-self: flex-end; padding-right: 50px; padding-left: 50px;" />
                </ui:VisualElement>
                <ui:VisualElement name="BottomAnchor" class="ttbAnchors" />
            </ui:VisualElement>
            <ui:VisualElement name="RightAnchor" class="ltrAnchors" style="width: 20%;">
                <ui:VisualElement name="TopAnchor" class="ttbAnchors" />
                <ui:VisualElement name="MiddleAnchor" class="ttbAnchors" />
                <ui:VisualElement name="BottomAnchor" class="ttbAnchors" style="justify-content: flex-end;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MissionStartedScreen" style="width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.7); justify-content: center; align-self: center; align-items: center; display: none;">
            <ui:Label tabindex="-1" text="MISSION: ONGOING" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MissionStartedText" style="justify-content: center; align-items: center; align-self: center; color: rgb(255, 255, 255); font-size: 60px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: middle-center; text-shadow: 1px 0 4px rgb(0, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement name="ScreenParent" picking-mode="Ignore" class="screenParent" style="position: absolute;">
            <ui:VisualElement name="LeftAnchor" picking-mode="Ignore" class="ltrAnchors" style="width: 20%;">
                <ui:Button text="Exit Terminal" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Exit" class="text-only-button" style="font-size: 20px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
