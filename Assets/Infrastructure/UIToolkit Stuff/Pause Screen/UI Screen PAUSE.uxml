<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="UI Terminal OPTIONS UXML" src="project://database/Assets/Infrastructure/UIToolkit%20Stuff/Options%20Terminal/UI%20Terminal%20OPTIONS%20UXML.uxml?fileID=9197481963319205126&amp;guid=bfdff6c542bd74becac605d138651f84&amp;type=3#UI Terminal OPTIONS UXML" />
    <Style src="project://database/Assets/Infrastructure/UIToolkit%20Stuff/TerminalStyleSheet.uss?fileID=7433441132597879392&amp;guid=96d5bf98c481b49caa12dd0ff60b4887&amp;type=3#TerminalStyleSheet" />
    <ui:VisualElement name="ScreenView" picking-mode="Ignore" style="width: 100%; height: 100%; -unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/Oxanium-VariableFont_wght.ttf?fileID=12800000&amp;guid=18af7650e00930b48b048a87fcc0a4d3&amp;type=3#Oxanium-VariableFont_wght&quot;);">
        <ui:VisualElement name="PauseScreen" style="width: 100%; height: 100%; justify-content: flex-start; padding-left: 5%; padding-right: 5%; padding-top: 5%; padding-bottom: 5%; position: absolute; background-color: rgba(0, 0, 0, 0.5); top: 0; left: 0; display: none;">
            <ui:VisualElement name="LeftAnchor" style="width: 30%;">
                <ui:Label text="Paused" display-tooltip-when-elided="true" name="PauseTitle" style="-unity-text-align: middle-left; font-size: 40px; letter-spacing: 6px; margin-bottom: 10px; padding-left: 15px; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0; color: rgb(0, 230, 255);" />
                <ui:VisualElement name="PauseButtons" style="flex-direction: column; align-items: flex-start;">
                    <ui:Button text="Resume" display-tooltip-when-elided="true" name="Resume" usage-hints="DynamicColor" class="uiTab textButton" />
                    <ui:Button text="Options" display-tooltip-when-elided="true" name="Options" usage-hints="DynamicColor" class="uiTab mainMenuButton textButton" />
                    <ui:Button text="Reload Scene" display-tooltip-when-elided="true" name="ReloadScene" usage-hints="DynamicColor" class="uiTab mainMenuButton textButton" />
                    <ui:Button text="Quit Game" display-tooltip-when-elided="true" name="QuitGame" usage-hints="DynamicColor" class="uiTab mainMenuButton textButton" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="UI Terminal OPTIONS UXML" name="OptionsScreen" style="position: absolute; width: 100%; height: 100%; display: none;" />
    </ui:VisualElement>
</ui:UXML>
