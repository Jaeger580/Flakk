<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Infrastructure/UIToolkit%20Stuff/TerminalStyleSheet.uss?fileID=7433441132597879392&amp;guid=96d5bf98c481b49caa12dd0ff60b4887&amp;type=3#TerminalStyleSheet" />
    <ui:VisualElement name="ScreenView" style="width: 100%; height: 100%;">
        <ui:VisualElement name="WinScreen" style="width: 100%; height: 100%; justify-content: center; padding-left: 5%; padding-right: 5%; padding-top: 5%; padding-bottom: 5%; position: absolute; background-color: rgba(0, 0, 0, 0.75); top: 0; left: 0; display: none; align-items: center; opacity: 0;">
            <ui:Label tabindex="-1" text="MISSION" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MissionLabel" class="winScreenText" style="translate: -1000px 0%; scale: 0.5 0.5;" />
            <ui:Label tabindex="-1" text="COMPLETE" parse-escape-sequences="true" display-tooltip-when-elided="true" name="CompleteLabel" class="winScreenText" style="translate: 1000px 0; scale: 0.5 0.5;" />
            <ui:Label tabindex="-1" text="REWARD: $000" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RewardLabel" class="winScreenText" style="top: 60px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
